# Gaze scepter
qlippoth-gaze-seek = The lantern turns toward {$target}.
qlippoth-gaze-no-target = The lantern flickers. Nothing here answers it.

# Edge sword
qlippoth-edge-taken = The blade settles into your grip.
qlippoth-edge-stance-defensive = Stance: defensive.
qlippoth-edge-stance-offensive = Stance: offensive.
qlippoth-edge-parry = The blade flicks out and turns the blow aside!
qlippoth-edge-repeat = The blade echoes your strike.

# Key
qlippoth-key-unlock = The door gives way to the key.
qlippoth-key-welded = The key cannot argue with a weld.
qlippoth-key-seal = The key turns. {$count} doors slam shut and bolt.
qlippoth-key-release = The key turns back. {$count} doors unbolt and swing open.
