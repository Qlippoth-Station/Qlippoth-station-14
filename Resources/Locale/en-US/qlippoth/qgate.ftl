## Q-Gate Announcements

qgate-announcement-warning = ATTENTION: Dimensional instability detected. A Q-Gate spawn is imminent. Estimated Location: {$location}. Estimated Threat: {$phase}. Prepare response teams.
qgate-announcement-spawn = WARNING: Q-Gate opened! Confirmed Location: {$location}. Threat Level: {$phase}. Response team deploy immediately.
qgate-announcement-breach = ALERT: Q-Gate breached at {$location}! Entities spilling into the station. All personnel gear up and enforce quarantine protocols!
qgate-announcement-cleared = NOTICE: Q-Gate neutralized at {$location}. Entity secured by CentCom and listed on the Command Containment Auction.
qgate-announcement-sealed = NOTICE: Breached Q-Gate at {$location} sealed by Science. The escaped Qlippoth remains unsecured.
qgate-announcement-containment = NOTICE: Transport capsule delivered to the Containment Dimension. Security personnel must complete chamber docking.
qgate-announcement-capsule-breach = ALERT: Qlippoth transport capsule destroyed during delivery! Containment breach confirmed at {$location}!
qgate-seal-invalid-target = The seal device can only be used on a breached Q-Gate.

